# Optional legacy contact receiver (not used by the Google Calendar demo page).
# Supports a Formspree form URL:
# https://formspree.io/f/YOUR_FORM_ID (replace with the actual account endpoint).
# Or use a custom receiver: POST JSON, CORS, 2xx with {"accepted":true}.
# This value is public; never put API keys or secrets here.
NEXT_PUBLIC_LEAD_ENDPOINT=
# Set only once the real company LinkedIn URL is confirmed.
NEXT_PUBLIC_LINKEDIN_URL=
# Site origin used by canonical URLs, sitemap and Open Graph. Set on Hostinger.
NEXT_PUBLIC_SITE_URL=https://cross-dock.ai
